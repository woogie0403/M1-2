# Google Gemini API Key (무료)
GEMINI_API_KEY=your_gemini_api_key_here

# (선택) Gemini OpenAI 호환 엔드포인트 URL
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/

# AI Model
AI_MODEL=gemini-3.8-flash

# (선택) OpenAI API Key 사용 시
# OPENAI_API_KEY=your_openai_api_key_here

# Firebase Admin Service Account Key Path
FIREBASE_SERVICE_ACCOUNT_KEY=./serviceAccountKey.json

# (배포 환경용) JSON 내용을 한 줄 문자열로 넣을 때 사용:
# FIREBASE_SERVICE_ACCOUNT_JSON={"type": "service_account", ...}

# CORS 허용 Origin 목록 (쉼표 구분)
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:5500,http://localhost:8000

# 프론트엔드에서 참조할 백엔드 API 기본 주소 (배포 시 변경)
API_BASE_URL=http://localhost:8000
